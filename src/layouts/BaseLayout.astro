---
import '../styles/fonts.css';
import '../styles/global.css';

// `lang` gobierna el atributo del <html>. Estaba fijo en "en", así que las 43
// piezas en español se anunciaban como inglesas a lectores de pantalla, al
// silabeo del navegador y a los buscadores.
const {
  title,
  description,
  lang = 'en',
  // Traducciones existentes de esta página, para hreflang recíproco.
  alternates = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
const OG_LOCALE = { en: 'en_US', es: 'es_ES' };
---
<!DOCTYPE html>
<html lang={lang}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={canonical} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="alternate" type="application/rss+xml" title="Glossa — English" href="/rss.xml" />
<link rel="alternate" type="application/rss+xml" title="Glossa — español" href="/rss-es.xml" />

{alternates.map(a => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site).href} />)}
{alternates.length > 0 && (
  <link rel="alternate" hreflang="x-default" href={new URL(alternates[0].href, Astro.site).href} />
)}

<meta property="og:type" content="article" />
<meta property="og:site_name" content="Glossa" />
<meta property="og:locale" content={OG_LOCALE[lang] ?? 'en_US'} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage} />

<script is:inline>
(function(){
  try {
    // Clave renombrada tras el rebrand; migramos la antigua una sola vez para
    // no perder la preferencia de quien ya venía leyendo.
    var s = localStorage.getItem('glossa-text-size');
    if (!s) {
      var legacy = localStorage.getItem('lecturas-text-size');
      if (legacy) { s = legacy; localStorage.setItem('glossa-text-size', legacy); }
    }
    document.documentElement.setAttribute('data-text-size', s || 'md');
  } catch (e) {}
})();
</script>
</head>
<body>
<slot />
<script is:inline>
(function(){
  var btns = document.querySelectorAll('.text-size-switch button');
  function paint(s){ btns.forEach(function(b){ b.classList.toggle('active', b.dataset.size === s); }); }
  var cur = document.documentElement.getAttribute('data-text-size') || 'md';
  paint(cur);

  // Capture the text element near the reading sweet spot of the viewport.
  // We use 1/4 from the top — typical reading focus zone, well below any masthead.
  function captureAnchor(){
    var sweetSpotY = Math.max(60, window.innerHeight * 0.25);
    var sweetSpotX = Math.max(20, window.innerWidth * 0.5);
    var el = document.elementFromPoint(sweetSpotX, sweetSpotY);
    if (!el) return null;
    // Find the nearest piece of body content to anchor to.
    var container = el.closest(
      '.article p, .article h2, .article h3, .article h4, .article li, ' +
      '.article figure, .article blockquote, .article .exhibit, .article section'
    );
    if (!container) return null;
    return { element: container, viewportOffset: container.getBoundingClientRect().top };
  }

  // After the size attribute changes, the browser will recompute layout
  // when we read getBoundingClientRect — forcing a synchronous reflow.
  // We use that value to compute how far to scroll to keep the anchor in place.
  function restoreAnchor(anchor){
    if (!anchor || !anchor.element) return;
    var newTop = anchor.element.getBoundingClientRect().top;
    var delta = newTop - anchor.viewportOffset;
    if (Math.abs(delta) > 1) window.scrollBy(0, delta);
  }

  btns.forEach(function(b){
    b.addEventListener('click', function(){
      var anchor = captureAnchor();
      var s = b.dataset.size;
      document.documentElement.setAttribute('data-text-size', s);
      try { localStorage.setItem('glossa-text-size', s); } catch(e){}
      paint(s);
      restoreAnchor(anchor);
      // The scrollBy above will fire a scroll event that ReadingProgress
      // is already listening to, so the percentage recalculates naturally.
    });
  });
})();
</script>
</body>
</html>
