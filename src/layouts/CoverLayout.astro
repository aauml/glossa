---
import BaseLayout from './BaseLayout.astro';
import CoverMasthead from '../components/CoverMasthead.astro';

const { lang = 'en' } = Astro.props;

const META = {
  en: {
    title: 'Glossa · Annotated readings',
    // La misma promesa que la portada, en una línea. Llevaba el eslogan viejo
    // —«I direct, AI executes»— que se retiró de la página hace semanas: lo veía
    // el buscador y quien pegaba el enlace, o sea todo el mundo menos quien la
    // leía.
    description: 'The writers, sites, podcasts and videos I follow, read every week and written back with what is solid and what only one source claims.',
  },
  es: {
    title: 'Glossa · Lecturas anotadas',
    description: 'Los autores, sitios, pódcast y videos que sigo, leídos cada semana y escritos de vuelta señalando qué está firme y qué lo dice una sola fuente.',
  },
};

const ALTERNATES = [{ lang: 'en', href: '/' }, { lang: 'es', href: '/es/' }];
---
<BaseLayout title={META[lang].title} description={META[lang].description} lang={lang} alternates={ALTERNATES}>
  <CoverMasthead lang={lang} />
  <slot />
</BaseLayout>
