---
import '../styles/admin.css';
const { title, tab } = Astro.props;
// Dos pestañas: lo que entra y lo que sale. Antes eran cuatro —Status, Sources,
// Inbox, Weekly— y alimentar el sistema obligaba a saber de antemano en cuál de
// las tres caía lo que tenías en la mano.
const TABS = [
  { href: '/admin/',        label: 'Feed',     id: 'feed' },
  { href: '/admin/weekly/', label: 'Articles', id: 'weekly' },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} · Glossa</title>
<!-- El panel no es contenido: que ningún buscador lo indexe ni lo siga. -->
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<!-- Para «añadir a la pantalla de inicio». Sin estas cuatro líneas, iOS y
     Android improvisan: recortan un pantallazo de la página o ponen la inicial
     sobre un cuadro NEGRO, que es lo contrario de esta marca. El color de tema
     es el papel, así que la barra del sistema se funde con la página. -->
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#F4EDE4" />
<meta name="apple-mobile-web-app-title" content="Glossa" />
</head>
<body class="admin">
  <header class="admin-bar">
    <a class="admin-brand" href="/">Glossa<span style="color:var(--accent)">.</span></a>
    <nav class="admin-tabs">{TABS.map(t => <a href={t.href} class={t.id === tab ? 'on' : ''}>{t.label}</a>)}</nav>
    <form method="POST" action="/api/admin/logout/"><button class="admin-salir" type="submit">sign out</button></form>
  </header>
  <main class="admin-main"><slot /></main>
</body>
</html>
