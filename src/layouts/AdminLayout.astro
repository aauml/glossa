---
import '../styles/admin.css';
const { title, tab } = Astro.props;
const TABS = [
  { href: '/admin/',         label: 'Estado',  id: 'estado' },
  { href: '/admin/fuentes/', label: 'Fuentes', id: 'fuentes' },
  { href: '/admin/bandeja/', label: 'Bandeja', id: 'bandeja' },
];
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title} · Glossa</title>
<!-- El panel no es contenido: que ningún buscador lo indexe ni lo siga. -->
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="admin">
  <header class="admin-bar">
    <a class="admin-brand" href="/">Glossa<span style="color:var(--accent)">.</span></a>
    <nav class="admin-tabs">{TABS.map(t => <a href={t.href} class={t.id === tab ? 'on' : ''}>{t.label}</a>)}</nav>
    <form method="POST" action="/api/admin/logout/"><button class="admin-salir" type="submit">salir</button></form>
  </header>
  <main class="admin-main"><slot /></main>
</body>
</html>
