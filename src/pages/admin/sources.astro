---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Sources" tab="sources">

  <h1>Sources</h1>
  <p class="sub">Channels, podcasts and outlets the radar checks every night. The feed is verified before it is saved:
  a broken source failing silently every night is worse than an error now.</p>

  <div class="admin-sec">
    <h2>Add</h2>
    <div id="msg"></div>
    <form class="admin-form" id="alta">
      <label>Feed URL
        <input name="feed_url" placeholder="https://…/feed.xml  ·  or the YouTube channel URL" required /></label>
      <div class="admin-row">
        <label style="flex:1">Type
          <select name="kind">
            <option value="youtube">YouTube channel</option>
            <option value="podcast">Podcast</option>
            <option value="rss">Written outlet</option>
          </select></label>
        <label style="flex:2">Name <span class="hint">— taken from the feed if left blank</span>
          <input name="name" /></label>
      </div>
      <label>Note <span class="hint">— e.g. its editorial leaning, so the analysis accounts for it</span>
        <input name="notes" /></label>
      <div class="admin-acciones">
        <button class="admin-btn" type="submit">Add</button>
        <button class="admin-btn sec" type="button" id="probar">just test the feed</button>
      </div>
    </form>
  </div>

  <div class="admin-sec">
    <h2>Watching</h2>
    <div id="lista"><span class="admin-vacio">loading…</span></div>
  </div>

<script>
  const api = (op, extra = {}) => fetch('/api/admin/op/', { method: 'POST',
    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op, ...extra }) }).then(r => r.json());
  const esc = s => String(s ?? '').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
  const msg = (id, t, ok) => { document.getElementById(id).innerHTML = `<div class="admin-msg ${ok?'ok':''}">${esc(t)}</div>`; };

  // El enlace de un canal de YouTube no es su feed; se convierte aquí para no
  // tener que saberse la URL del RSS.
  const normalizar = (url, kind) => {
    if (kind !== 'youtube') return url;
    const m = /youtube\.com\/channel\/(UC[\w-]+)/.exec(url);
    return m ? `https://www.youtube.com/feeds/videos.xml?channel_id=${m[1]}` : url;
  };

  async function pintar() {
    const d = await api('sources.list');
    const el = document.getElementById('lista');
    if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    if (!d.sources.length) { el.innerHTML = '<span class="admin-vacio">No sources yet.</span>'; return; }
    el.innerHTML = `<table class="admin-tabla"><thead><tr>
        <th>Name</th><th>Type</th><th>Feed</th><th>Checked</th><th></th></tr></thead><tbody>` +
      d.sources.map(s => `<tr class="${s.active ? '' : 'off'}">
        <td>${esc(s.name)}${s.notes ? `<div class="admin-nota">${esc(s.notes)}</div>` : ''}</td>
        <td><span class="admin-kind">${esc(s.kind)}</span></td>
        <td class="admin-url">${esc(s.feed_url)}</td>
        <td style="white-space:nowrap;color:var(--muted)">${s.last_checked_at ? esc(s.last_checked_at.slice(0,10)) : '—'}</td>
        <td style="white-space:nowrap"><button class="admin-btn sec" data-t="${s.id}" data-a="${s.active?'0':'1'}">${s.active?'pause':'activate'}</button>
          &nbsp; <button class="admin-btn sec" data-d="${s.id}" data-n="${esc(s.name)}">remove</button></td>
      </tr>`).join('') + '</tbody></table>';

    el.querySelectorAll('[data-t]').forEach(b => b.onclick = async () => {
      await api('sources.toggle', { id: b.dataset.t, active: b.dataset.a === '1' }); pintar(); });
    el.querySelectorAll('[data-d]').forEach(b => b.onclick = async () => {
      if (!confirm(`Remove “${b.dataset.n}”? Episodes already processed go with it.`)) return;
      await api('sources.delete', { id: b.dataset.d }); pintar(); });
  }

  document.getElementById('probar').onclick = async () => {
    const f = document.getElementById('alta');
    msg('msg', 'checking…', true);
    const r = await api('sources.check', { feed_url: normalizar(f.feed_url.value.trim(), f.kind.value) });
    msg('msg', r.ok ? `Responds fine: “${r.nombre || 'untitled'}”` : r.error, r.ok);
  };

  document.getElementById('alta').onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target, btn = f.querySelector('button[type=submit]');
    btn.disabled = true; msg('msg', 'checking the feed…', true);
    const r = await api('sources.create', {
      feed_url: normalizar(f.feed_url.value.trim(), f.kind.value),
      kind: f.kind.value, name: f.name.value.trim(), notes: f.notes.value.trim() });
    btn.disabled = false;
    if (r.error) { msg('msg', r.error, false); return; }
    msg('msg', `Added: ${r.source.name}`, true); f.reset(); pintar();
  };
  pintar();
</script>
</AdminLayout>
