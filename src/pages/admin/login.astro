---
export const prerender = false;
import '../../styles/fonts.css';
import '../../styles/global.css';
import '../../styles/admin.css';
const err = Astro.url.searchParams.get('e');
const next = Astro.url.searchParams.get('next') || '/admin/';
---
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Entrar · Glossa</title>
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body class="admin">
  <div class="login-caja">
    <h1>Glossa<span class="wm-dot">.</span></h1>
    <p>Panel de administración</p>
    {err && <div class="admin-msg">Contraseña incorrecta.</div>}
    <form class="admin-form" method="POST" action="/api/admin/login/">
      <input type="hidden" name="next" value={next} />
      <label>
        Contraseña
        <input type="password" name="password" autocomplete="current-password" autofocus required />
      </label>
      <button class="admin-btn" type="submit">Entrar</button>
    </form>
  </div>
</body>
</html>
