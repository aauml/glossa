---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Bandeja" tab="bandeja">
  <h1>Bandeja</h1>
  <p class="sub">
    Lo que quieras meter a mano: un artículo que estás leyendo, un enlace suelto.
    Entra en la misma cola que los canales y acaba cruzándose con el resto del material del tema.
  </p>

  <div class="admin-msg" style="border-left-color:var(--gold)">
    El texto que pegues es <strong>material de trabajo privado</strong>: se usa para analizar
    y citar corto, y no se republica. Si viene de una suscripción tuya, ahí se queda.
  </div>

  <div class="admin-sec">
    <h2>Añadir</h2>
    <div id="msg"></div>
    <form class="admin-form" id="alta">
      <div class="admin-row">
        <label style="flex:2">Enlace <span style="opacity:.6">(opcional si pegas el texto)</span>
          <input name="url" placeholder="https://…" /></label>
        <label style="flex:1">Autor <span style="opacity:.6">(opcional)</span><input name="author" /></label>
      </div>
      <label>Título<input name="title" placeholder="Cómo lo quieres ver en la lista" /></label>
      <label>
        Texto <span style="opacity:.6">— pégalo si quieres que se analice a fondo; con solo el enlace se queda en la superficie</span>
        <textarea name="body_text" placeholder="Pega aquí el artículo…"></textarea>
      </label>
      <label>
        Por qué te interesa <span style="opacity:.6">— esto orienta el análisis, no es decoración</span>
        <input name="note" placeholder="p. ej. contradice lo que dijo Hudson la semana pasada" />
      </label>
      <div><button class="admin-btn" type="submit">Guardar en la bandeja</button></div>
    </form>
  </div>

  <div class="admin-sec">
    <h2>En la bandeja</h2>
    <div id="lista"><span class="admin-vacio">cargando…</span></div>
  </div>

  <script>
    const api = (op, extra = {}) =>
      fetch('/api/admin/op/', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op, ...extra }) }).then(r => r.json());
    const esc = s => String(s ?? '').replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    const msg = (t, ok) => { document.getElementById('msg').innerHTML = `<div class="admin-msg ${ok ? 'ok' : ''}">${esc(t)}</div>`; };
    const ESTADO = { pending: 'en cola', running: 'procesando', digested: 'analizado', skipped: 'descartado', error: 'error' };

    async function pintar() {
      const d = await api('inbox.list');
      const el = document.getElementById('lista');
      if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
      if (!d.items.length) { el.innerHTML = '<span class="admin-vacio">La bandeja está vacía.</span>'; return; }
      el.innerHTML = `<table class="admin-tabla"><thead><tr>
          <th>Qué</th><th>Estado</th><th>Entró</th><th></th></tr></thead><tbody>` +
        d.items.map(i => `<tr>
          <td><strong>${esc(i.title)}</strong>
            ${i.url && i.url !== 'about:blank' ? `<div class="admin-url">${esc(i.url)}</div>` : ''}
            ${i.note ? `<div class="admin-nota">${esc(i.note)}</div>` : ''}
            ${i.error ? `<div class="admin-nota" style="color:var(--accent)">${esc(i.error)}</div>` : ''}</td>
          <td style="white-space:nowrap">${esc(ESTADO[i.state] || i.state)}</td>
          <td style="white-space:nowrap;color:var(--muted)">${esc((i.published_at || '').slice(0, 10))}</td>
          <td><button class="admin-btn sec" data-d="${i.id}">Quitar</button></td>
        </tr>`).join('') + '</tbody></table>';

      el.querySelectorAll('[data-d]').forEach(b => b.onclick = async () => {
        await api('inbox.delete', { id: b.dataset.d }); pintar();
      });
    }

    document.getElementById('alta').onsubmit = async (e) => {
      e.preventDefault();
      const f = e.target, btn = f.querySelector('button[type=submit]');
      btn.disabled = true;
      const r = await api('inbox.add', {
        url: f.url.value.trim(), title: f.title.value.trim(), author: f.author.value.trim(),
        body_text: f.body_text.value, note: f.note.value.trim(),
      });
      btn.disabled = false;
      if (r.error) { msg(r.error, false); return; }
      msg('Guardado. Se analizará en la próxima pasada.', true); f.reset(); pintar();
    };

    pintar();
  </script>
</AdminLayout>
