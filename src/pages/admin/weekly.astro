---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { articlesByLang } from '../../lib/collection.js';
import '../../styles/weekly.css';

// Las piezas del sitio se listan aquí mismo, en el servidor: son la colección
// de contenido que ya está en el build, no hace falta preguntarle a la base.
// Se listan las inglesas (cada pieza tiene su gemela española en la misma URL).
const piezas = await articlesByLang('en');
---
<AdminLayout title="Articles" tab="weekly">
  <!-- Antes esta página era el taller del número: Rebuild, Publish, Withdraw y
       la vista previa siempre abierta. Una vez hecho el número, nada de eso
       tiene sentido — se pidió, con razón, un listado discreto y un solo
       control: borrar. La revisión del borrador se conserva, pero solo aparece
       cuando HAY un borrador que revisar. -->
  <div id="msg"></div>

  <!-- ── El borrador, si lo hay ─────────────────────────────────────────── -->
  <section class="admin-sec" id="borrador" hidden>
    <h2>Draft waiting</h2>
    <p class="admin-nota" id="meta"></p>
    <div id="fusible"></div>
    <div class="admin-acciones" style="margin-bottom:8px">
      <button class="admin-btn" id="publish">Publish</button>
    </div>
    <details>
      <summary>Read the draft</summary>
      <div id="issue" class="weekly" style="margin-top:14px"></div>
    </details>
  </section>

  <!-- ── Los números semanales ──────────────────────────────────────────── -->
  <section class="admin-sec">
    <h2>Weekly issues <span id="wk-cuenta" class="admin-kind"></span></h2>
    <div id="wk-lista"><span class="admin-vacio">loading…</span></div>
  </section>

  <!-- El único ajuste que gobierna el número, y por eso vive aquí y no en el
       Feed: si el domingo se publica solo o espera a que lo mires. -->
  <label class="admin-nota" style="display:flex;gap:9px;align-items:baseline;margin:26px 0">
    <input type="checkbox" id="st-auto" />
    <span>Publish the weekly issue without review</span>
  </label>

  <!-- ── Las piezas ─────────────────────────────────────────────────────── -->
  <section class="admin-sec">
    <h2>Pieces <span class="admin-kind">{piezas.length}</span></h2>
    <table class="admin-tabla">
      {piezas.map(p => (
        <tr>
          <td style="color:var(--muted);white-space:nowrap">{p.data.sortDate.slice(0, 10)}</td>
          <td style="color:var(--muted);white-space:nowrap">{p.data.issue}</td>
          <td><a href={`/articles/${p.slug}/en/`} target="_blank" rel="noopener">{p.data.title}</a></td>
        </tr>
      ))}
    </table>
    <p class="admin-nota" style="margin-top:8px">
      Pieces live in the repo, not in a table — removing one is a commit, which is
      done from a conversation, not from a button here.
    </p>
  </section>

<script>
  import { renderIssue } from '../../lib/weekly.js';
  import { api, esc, msg as msgEl, delegar } from '../../lib/panel.js';
  const $ = (id) => document.getElementById(id);
  const msg = (t, ok) => msgEl($('msg'), t, ok);

  let borrador = null;

  // ── El borrador, solo si existe ──────────────────────────────────────────
  async function pintarBorrador() {
    const d = await api('weekly.latest');
    if (d.error || !d.issue || d.issue.state === 'publicado') { $('borrador').hidden = true; return; }
    borrador = d.issue;
    $('borrador').hidden = false;
    $('meta').textContent =
      `${borrador.parcial ? 'PARTIAL CUT (week still open) · ' : ''}` +
      `${borrador.week_start} → ${borrador.week_end} · ${borrador.item_count} episodes` +
      `${borrador.reportaje_count ? ` · ${borrador.reportaje_count} outside reports` : ''}` +
      `${borrador.cotejo_count ? ` · ${borrador.cotejo_count} claims cross-checked` : ''}`;

    // El fusible corre el mismo código que corrió al escribir el número.
    const f = borrador.fuse;
    const graves = (f?.fallos || []).filter(x => x.grave);
    const avisos = (f?.fallos || []).filter(x => !x.grave);
    $('fusible').innerHTML = !f ? '' : graves.length
      ? `<div class="admin-msg" style="margin-bottom:16px">
           <strong>The fuse would hold this back.</strong> Publishing here overrides it.
           ${graves.map(x => `<div class="admin-nota">✗ <strong>${esc(x.regla)}</strong> — ${esc(x.detalle)}</div>`).join('')}
           ${avisos.map(x => `<div class="admin-nota" style="opacity:.7">· ${esc(x.regla)} — ${esc(x.detalle)}</div>`).join('')}
         </div>`
      : `<div class="admin-msg ok" style="margin-bottom:16px">
           The fuse passes this issue${avisos.length ? `, with ${avisos.length} thing(s) worth a look` : ''}.
           ${avisos.map(x => `<div class="admin-nota">· ${esc(x.regla)} — ${esc(x.detalle)}</div>`).join('')}
         </div>`;
    $('issue').innerHTML = renderIssue(borrador.body || {});
  }

  $('publish').onclick = async (e) => {
    if (!borrador) return;
    if (!confirm('Publish this issue at glossa.ademas.ai? Anyone will be able to read it.')) return;
    e.target.disabled = true;
    const r = await api('weekly.publish', { week_start: borrador.week_start });
    e.target.disabled = false;
    if (r.error) { msg(r.error, false); return; }
    msg('Published.', true);
    pintarBorrador(); pintarLista();
  };

  // ── El listado, cronológico y discreto ───────────────────────────────────
  async function pintarLista() {
    const d = await api('weekly.list');
    const el = $('wk-lista');
    if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    $('wk-cuenta').textContent = d.issues.length || '';
    if (!d.issues.length) { el.innerHTML = '<span class="admin-vacio">No issues yet.</span>'; return; }
    el.innerHTML = `<table class="admin-tabla">
      ${d.issues.map(i => `<tr>
        <td style="white-space:nowrap">${esc(i.week_start)} → ${esc(i.week_end)}</td>
        <td><span class="admin-kind">${esc(i.state)}</span></td>
        <td style="color:var(--muted);white-space:nowrap">${i.topic_count ?? '—'} topics · ${i.item_count ?? '—'} items</td>
        <td>${i.state === 'publicado'
          ? `<a href="/weekly/${esc(i.week_start)}/" target="_blank" rel="noopener">view</a>` : ''}</td>
        <td><button class="admin-btn sec" data-del="${esc(i.week_start)}">delete</button></td>
      </tr>`).join('')}</table>`;
  }

  delegar($('wk-lista'), '[data-del]', async (b) => {
    if (!confirm(`Delete the issue of ${b.dataset.del}?\n\nIf it is published, its page disappears from the site. ` +
                 `The material it read stays in the database. This cannot be undone.`)) return;
    b.disabled = true;
    const r = await api('weekly.delete', { week_start: b.dataset.del });
    if (r.error) { msg(r.error, false); b.disabled = false; return; }
    msg('Deleted.', true);
    pintarBorrador(); pintarLista();
  });

  // El interruptor de auto-publicar: se lee al entrar y se guarda al tocarlo.
  (async () => {
    const s = await api('settings.get');
    if (!s.error) $('st-auto').checked = s.auto_publicar === true;
  })();
  $('st-auto').onchange = async (e) => {
    const r = await api('settings.set', { key: 'auto_publicar', value: e.target.checked });
    msg(r.error ? `No se pudo guardar: ${r.error}` : (e.target.checked
      ? 'The Sunday issue will publish itself when the fuse passes.'
      : 'The issue will wait for you.'), !r.error);
  };

  pintarBorrador(); pintarLista();
</script>
</AdminLayout>
