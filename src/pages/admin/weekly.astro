---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import '../../styles/weekly.css';
---
<AdminLayout title="Weekly" tab="weekly">
  <h1>Weekly issue</h1>
  <p class="sub">
    Exactly as it will read once published — same renderer, same stylesheet. If the draft
    looked different from the live page, reviewing it would prove nothing.
  </p>

  <div id="msg"></div>
  <div class="admin-acciones" style="margin-bottom:8px">
    <button class="admin-btn" id="rebuild">Rebuild this week</button>
    <button class="admin-btn" id="publish" hidden></button>
    <a class="admin-btn" id="ver" hidden target="_blank" rel="noopener">View live page</a>
  </div>
  <p class="admin-nota" id="meta"></p>

  <div id="issue" class="weekly"><span class="admin-vacio">loading…</span></div>
  <a href="#contents" id="weekly-top" aria-label="Back to contents">↑</a>

<script>
  import { renderIssue } from '../../lib/weekly.js';

  const api = (op, extra = {}) => fetch('/api/admin/op/', { method: 'POST',
    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op, ...extra }) }).then(r => r.json());
  const esc = (s) => String(s ?? '').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
  const msg = (t, ok) => { document.getElementById('msg').innerHTML =
    `<div class="admin-msg ${ok ? 'ok' : ''}">${esc(t)}</div>`; };

  let actual = null;

  // La flecha sólo aparece cuando el índice ya quedó atrás. Se arma tras pintar,
  // porque antes de eso el índice no existe en la página.
  function armarFlecha() {
    const b = document.getElementById('weekly-top');
    const i = document.getElementById('contents');
    if (!b || !i || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(
      (e) => b.classList.toggle('on', !e[0].isIntersecting && e[0].boundingClientRect.top < 0),
      { threshold: 0 }).observe(i);
  }

  async function pintar() {
    const d = await api('weekly.latest');
    const el = document.getElementById('issue');
    const bp = document.getElementById('publish');
    const ver = document.getElementById('ver');

    if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    if (!d.issue) {
      el.innerHTML = '<span class="admin-vacio">No issue yet. Rebuild once there is a week of material.</span>';
      return;
    }
    actual = d.issue;
    const publicado = actual.state === 'publicado';

    document.getElementById('meta').textContent =
      `${actual.week_start} → ${actual.week_end} · ${actual.item_count} episodes · ${actual.state}`;
    bp.hidden = false;
    bp.textContent = publicado ? 'Withdraw' : 'Publish';
    ver.hidden = !publicado;
    ver.href = `/weekly/${actual.week_start}/`;

    el.innerHTML = renderIssue(actual.body || {});
    armarFlecha();
  }

  document.getElementById('rebuild').onclick = async (e) => {
    e.target.disabled = true;
    msg('Asked GitHub to write it. It takes about 15 minutes — reload then.', true);
    const r = await api('weekly.rebuild');
    e.target.disabled = false;
    if (r.error) msg(r.error, false);
  };

  document.getElementById('publish').onclick = async (e) => {
    if (!actual) return;
    const publicando = actual.state !== 'publicado';
    if (publicando && !confirm('Publish this issue at glossa.ademas.ai? Anyone will be able to read it.')) return;
    e.target.disabled = true;
    const r = await api(publicando ? 'weekly.publish' : 'weekly.unpublish', { week_start: actual.week_start });
    e.target.disabled = false;
    if (r.error) { msg(r.error, false); return; }
    msg(publicando ? 'Published.' : 'Withdrawn — back to draft.', true);
    pintar();
  };

  pintar();
</script>
</AdminLayout>
