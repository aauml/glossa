---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Feed" tab="feed">
  <!-- ── La caja, antes que nada ─────────────────────────────────────────
       Sin título ni prosa encima: el placeholder ya dice qué acepta, y todo lo
       explicado dos veces es espacio quitado a lo que se vino a hacer. -->
  <section class="admin-sec" style="margin-top:6px">
    <form id="in-form" class="admin-form">
      <label>
        <textarea id="in-caja" rows="3" required
          placeholder="A link, a whole article pasted in, or a subject to follow"></textarea>
      </label>
      <p class="admin-nota" id="in-resuelto"></p>
      <div class="admin-acciones">
        <button class="admin-btn" type="submit" id="in-add">Add</button>
        <span id="in-alt"></span>
      </div>
    </form>
    <div id="in-msg"></div>
  </section>

  <!-- ── Esta semana, de un vistazo ─────────────────────────────────────── -->
  <div class="admin-cifras" id="st-cifras">
    <span class="admin-vacio">loading…</span>
  </div>
  <p class="admin-nota" id="st-corte" style="margin:10px 0 34px"></p>

  <!-- ── Lo que va mal ──────────────────────────────────────────────────
       Sólo si hay algo, y solo lo que resistió arreglarse solo: el vigilante
       recupera lo pasajero y archiva lo irrecuperable por su cuenta. -->
  <div id="inc-lista"></div>

  <!-- ── La cola ────────────────────────────────────────────────────────── -->
  <section class="admin-sec">
    <h2>Queue <span id="q-cuenta" class="admin-kind"></span></h2>
    <p class="admin-nota">What is waiting to be read or failed, plus anything you
      added in the last 48 h so you can see how it ended up. Read items clear out
      on their own.</p>
    <div id="q-lista"><span class="admin-vacio">loading…</span></div>
  </section>

  <!-- ── Lo que se sigue ────────────────────────────────────────────────── -->
  <section class="admin-sec">
    <h2>Following <span id="src-cuenta" class="admin-kind"></span></h2>
    <div id="src-lista"><span class="admin-vacio">loading…</span></div>
  </section>

  <!-- ── El vivero (0044) ───────────────────────────────────────────────
       Las fuentes que el sistema está criando solo: candidatos que las fuentes
       seguidas citan o que el reportaje encontró, y las altas a prueba que
       decidió el consejo. Aquí no se aprueba nada — el consejo decide; lo único
       que puede hacer una persona es vetar, y por eso solo hay ese botón. -->
  <section class="admin-sec">
    <details id="viv">
      <summary>Growing on its own <span id="viv-cuenta" class="admin-kind"></span></summary>
      <p class="admin-nota" style="margin-top:8px">
        Sources the system is raising by itself: names the followed channels cite as
        their own sources, and outlets the Friday reporting run kept finding. The
        Sunday committee decides admissions and verdicts; your only word here is a veto.
      </p>
      <div id="viv-lista" style="margin-top:12px"><span class="admin-vacio">loading…</span></div>
    </details>
  </section>

  <!-- ── Lo de dentro ───────────────────────────────────────────────────
       Cerrado por defecto. Nada de esto se usa a diario: son las cuentas del
       sistema y la única forma de deshacer una corrección del comité. Quitarlo
       del todo dejaría una corrección aplicada sin manera de revertirla. -->
  <section class="admin-sec">
    <details id="tripas">
      <summary>Under the hood</summary>
      <div style="margin-top:20px">
        <p class="admin-nota" id="st-gasto"></p>
        <p class="admin-nota" id="st-cupo" style="margin-top:8px"></p>
        <!-- Qué hace solo, dicho en dos líneas. Los mandos numéricos y la tabla
             de reparto que había aquí se quitaron a petición: si el reparto lo
             decide el sistema y lo corrige el comité, no hay nada que mover a
             mano — y una tabla que no cambia ninguna decisión es ruido. Los
             ajustes siguen en glossa_radar_settings para quien opere por SQL. -->
        <p class="admin-nota" style="margin-top:14px">
          On its own: every topic gets a free press sweep each Friday; paid searches
          go where that sweep came back thin, within whatever Tavily quota remains.
          Claims are cross-checked Saturdays, and on Sundays a committee of three
          outside models corrects calibration and decides which new sources to try.
        </p>
        <p class="admin-nota" id="st-cotejo" style="margin-top:8px"></p>
        <div id="con-lista" style="margin-top:20px"></div>
        <label style="display:flex;gap:9px;align-items:baseline;margin-top:26px;font-size:13px">
          <input type="checkbox" id="st-auto" />
          <span>Publish the weekly issue without review</span>
        </label>
      </div>
    </details>
  </section>

<script>
  import { api, esc, msg, delegar } from '../../lib/panel.js';
  import { hace } from '../../lib/tiempo.js';

  const $ = (id) => document.getElementById(id);
  const cajaMsg = $('in-msg'), resuelto = $('in-resuelto'), alt = $('in-alt');
  const listaQ = $('q-lista'), listaSrc = $('src-lista');

  // La flechita al final del título. Abre en otra pestaña porque salir del panel
  // para ver una fuente y tener que volver atrás es peor que no tener el enlace.
  const flecha = (url, titulo = '') => url && url !== 'about:blank'
    ? ` <a href="${esc(url)}" target="_blank" rel="noopener" title="${esc(titulo)}"
         style="text-decoration:none;color:var(--muted)">↗</a>` : '';

  // ── La caja ─────────────────────────────────────────────────────────────
  let forzado = null, ultimoPeek = '';

  async function mirar() {
    const t = $('in-caja').value.trim();
    if (t === ultimoPeek) return;
    ultimoPeek = t; forzado = null; alt.innerHTML = '';
    if (!t) { resuelto.textContent = ''; return; }
    resuelto.textContent = 'working out what that is…';
    const r = await api('intake.peek', { texto: t });
    if (r.error) { resuelto.textContent = ''; msg(cajaMsg, r.error, false); return; }
    resuelto.innerHTML = `→ ${esc(r.label)}`;
    alt.innerHTML = (r.alternativas || []).map((a, i) =>
      `<button class="admin-btn sec" type="button" data-alt="${i}"
         data-as="${esc(a.as)}" data-kind="${esc(a.kind || '')}" data-solo="${esc(a.solo || '')}">${esc(a.label)}</button>`).join(' ');
  }
  $('in-caja').addEventListener('blur', mirar);
  $('in-caja').addEventListener('paste', () => setTimeout(mirar, 60));

  delegar(alt, '[data-alt]', (b) => {
    forzado = { as: b.dataset.as, kind: b.dataset.kind || undefined,
                solo: b.dataset.solo || undefined };
    resuelto.innerHTML = `→ ${esc(b.textContent)} <span style="color:var(--muted)">(your call)</span>`;
    alt.innerHTML = '';
  });

  $('in-form').onsubmit = async (e) => {
    e.preventDefault();
    const t = $('in-caja').value.trim();
    if (!t) return;
    $('in-add').disabled = true;
    msg(cajaMsg, 'reading it…', true);
    const r = await api('intake.add', { texto: t, ...(forzado || {}) });
    $('in-add').disabled = false;
    if (r.error) { msg(cajaMsg, r.error, false); return; }
    // El aviso del alta —«lleva 11 días sin publicar»— viaja ahora en la
    // respuesta; antes se veía en el peek y desaparecía al confirmar.
    if (r.as === 'fuente' && r.aviso) { msg(cajaMsg, `Now following: ${r.source.name} — ${r.aviso}`, true); }
    else msg(cajaMsg, r.as === 'fuente' ? `Now following: ${r.source.name}`
                                   : `Queued: ${r.item.title.slice(0, 70)}`, true);
    $('in-caja').value = ''; resuelto.textContent = ''; alt.innerHTML = '';
    forzado = null; ultimoPeek = '';
    pintarCifras(); pintarCola(); pintarFuentes(); pintarTripas();
  };

  // ── La cola ─────────────────────────────────────────────────────────────
  const ESTADO = { pending: 'waiting', running: 'reading now', digested: 'read',
                   skipped: 'set aside', error: 'failed' };

  function procedencia(i) {
    if (i.glossa_radar_sources?.name) return i.glossa_radar_sources.name;
    if (i.author) return i.author;
    try { return new URL(i.url).hostname.replace(/^www\./, ''); } catch { return 'typed in'; }
  }

  async function pintarCola() {
    const d = await api('queue.list');
    if (d.error) { listaQ.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    const esperando = d.items.filter(i => i.state === 'pending' || i.state === 'running').length;
    $('q-cuenta').textContent = esperando ? `${esperando} waiting` : 'all read';
    if (!d.items.length) { listaQ.innerHTML = '<span class="admin-vacio">Nothing here.</span>'; return; }
    listaQ.innerHTML = `<table class="admin-tabla">
      ${d.items.map(i => `<tr>
        <td>${esc(i.title)}${flecha(i.url, i.title)}
          ${i.error ? `<div class="admin-nota" style="color:var(--accent)">${esc(i.error)}</div>` : ''}</td>
        <td style="color:var(--muted);white-space:nowrap">${esc(procedencia(i))}</td>
        <td><span class="admin-kind">${esc(ESTADO[i.state] || i.state)}</span></td>
        <td style="color:var(--muted);white-space:nowrap">${esc(hace(i.published_at))}</td>
        <td>${i.origin !== 'feed' ? `<button class="admin-btn sec" data-del="${i.id}">remove</button>` : ''}</td>
      </tr>`).join('')}</table>`;
  }

  delegar(listaQ, '[data-del]', async (b) => {
    b.disabled = true;
    const r = await api('inbox.delete', { id: b.dataset.del });
    if (r.error) msg(cajaMsg, r.error, false);
    pintarCola();
  });

  // ── Lo que se sigue ─────────────────────────────────────────────────────
  // Un grupo por tipo, plegable, con su cuenta. Veinte canales de YouTube
  // abiertos empujan todo lo demás fuera de la pantalla.
  const GRUPOS = [
    ['youtube', 'YouTube'], ['podcast', 'Podcasts'], ['rss', 'Outlets'],
    ['persona', 'People'],  ['tema', 'Topics'],
  ];

  async function pintarFuentes() {
    const d = await api('sources.panel');
    if (d.error) { listaSrc.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    const pend = d.sources.reduce((n, s) => n + Number(s.pendientes || 0), 0);
    $('src-cuenta').textContent = `${d.sources.length} · ${pend} in queue`;
    if (!d.sources.length) { listaSrc.innerHTML = '<span class="admin-vacio">Nothing yet.</span>'; return; }

    listaSrc.innerHTML = GRUPOS.map(([k, etiqueta]) => {
      const filas = d.sources.filter(s => s.kind === k);
      if (!filas.length) return '';
      const enCola = filas.reduce((n, s) => n + Number(s.pendientes || 0), 0);
      // Siempre contraídos, con la cuenta en el título: veinte canales abiertos
      // empujan todo lo demás fuera de la pantalla, haya cola o no.
      return `<details class="grupo">
        <summary>${etiqueta} <span class="admin-kind">${filas.length}${
          enCola ? ` · ${enCola} in queue` : ''}</span></summary>
        <table class="admin-tabla" style="margin-top:6px">
        ${filas.map(s => `<tr class="${s.active ? '' : 'off'}">
          <td>${esc(s.name)}${flecha(s.feed_url, s.name)}</td>
          <td style="text-align:right;font-variant-numeric:tabular-nums">${
            s.pendientes ? `<strong>${s.pendientes}</strong>` : '—'}</td>
          <td style="text-align:right;color:var(--muted);font-variant-numeric:tabular-nums">${
            s.procesados_7d || '—'}</td>
          <td style="color:var(--muted);white-space:nowrap">${esc(hace(s.last_checked_at))}</td>
          <td style="white-space:nowrap">
            <button class="admin-btn sec" data-t="${s.id}" data-a="${s.active ? '0' : '1'}"
              >${s.active ? 'pause' : 'activate'}</button>
            &nbsp;<button class="admin-btn sec" data-d="${s.id}" data-n="${esc(s.name)}" data-c="${s.leidos_total || 0}">remove</button>
          </td></tr>`).join('')}</table></details>`;
    }).join('');
  }

  delegar(listaSrc, '[data-t]', async (b) => {
    b.disabled = true;
    // El resultado se mira: un fallo silencioso aquí dejaba la fila reapareciendo
    // sin explicación tras el repintado.
    await api('sources.toggle', { id: b.dataset.t, active: b.dataset.a === '1' });
    pintarFuentes();
  });
  delegar(listaSrc, '[data-d]', async (b) => {
    // Borrar una fuente arrastra todos sus episodios y el análisis de cada uno —
    // trabajo ya pagado que no vuelve—. Perder cero y perder cuarenta y uno no
    // son la misma decisión, así que el aviso dice cuántos.
    const n = Number(b.dataset.c || 0);
    if (!confirm(`Stop following “${b.dataset.n}”?` +
      (n ? `\n\n${n} episode${n > 1 ? 's' : ''} already read will be deleted with it. This cannot be undone.`
         : '\n\nNothing has been read from it yet.'))) return;
    b.disabled = true;
    await api('sources.delete', { id: b.dataset.d });
    pintarFuentes(); pintarCola();
  });

  // ── El vivero ───────────────────────────────────────────────────────────
  // Se pinta al abrirlo, como las tripas: no es una vista de a diario.
  let viveroPintado = false;
  $('viv').addEventListener('toggle', () => {
    if ($('viv').open && !viveroPintado) { viveroPintado = true; pintarVivero(); }
  });

  const ESTADO_CAND = { candidato: 'candidate', a_prueba: 'on trial', confianza: 'trusted',
                        degradado: 'demoted', vetado: 'vetoed' };

  async function pintarVivero() {
    const d = await api('organicas.list');
    const el = $('viv-lista');
    if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
    const cand = d.candidatos || [];
    const enJuego = cand.filter(c => c.estado === 'candidato' || c.estado === 'a_prueba').length;
    $('viv-cuenta').textContent = enJuego ? `${enJuego} in play` : '';
    if (!cand.length) {
      el.innerHTML = '<span class="admin-vacio">Nothing yet — candidates appear as the followed sources cite people and outlets, and as the Friday run finds outlets that deliver.</span>';
      return;
    }
    const resumen = (c) => {
      const m = c.expediente?.menciones;
      const rep = c.expediente?.reportaje || [];
      const partes = [];
      if (m) partes.push(`cited by ${m.fuentes_distintas} source${m.fuentes_distintas > 1 ? 's' : ''} (${(m.citado_por || []).slice(0, 4).join(', ')})`);
      if (rep.length) partes.push(`delivered reporting in ${new Set(rep.map(x => x.semana)).size} week(s)`);
      if (c.motivo) partes.push(c.motivo);
      return partes.join(' · ');
    };
    el.innerHTML = `<table class="admin-tabla">
      ${cand.map(c => `<tr class="${['vetado', 'degradado'].includes(c.estado) ? 'off' : ''}">
        <td>${esc(c.nombre)}${flecha(c.homepage || c.feed_url, c.nombre)}
          <div class="admin-nota">${esc(resumen(c))}</div></td>
        <td><span class="admin-kind">${esc(ESTADO_CAND[c.estado] || c.estado)}</span></td>
        <td style="color:var(--muted)">${esc((c.temas || []).slice(0, 3).join(', '))}</td>
        <td style="white-space:nowrap">${c.estado === 'vetado'
          ? `<button class="admin-btn sec" data-viv-r="${c.id}">restore</button>`
          : `<button class="admin-btn sec" data-viv-v="${c.id}" data-n="${esc(c.nombre)}">veto</button>`}</td>
      </tr>`).join('')}</table>`;
  }

  delegar($('viv-lista'), '[data-viv-v]', async (b) => {
    if (!confirm(`Veto “${b.dataset.n}”? The committee will never admit it, and if it is on trial it stops now.`)) return;
    b.disabled = true;
    const r = await api('candidatos.vetar', { id: b.dataset.vivV });
    if (r.error) msg(cajaMsg, r.error, false);
    pintarVivero(); pintarFuentes();
  });
  delegar($('viv-lista'), '[data-viv-r]', async (b) => {
    b.disabled = true;
    const r = await api('candidatos.restaurar', { id: b.dataset.vivR });
    if (r.error) msg(cajaMsg, r.error, false);
    pintarVivero();
  });

  // ── Lo de dentro ────────────────────────────────────────────────────────
  // Se pinta solo al abrirlo: son cinco consultas que nadie necesita al entrar.
  let tripasPintadas = false;
  $('tripas').addEventListener('toggle', () => {
    if ($('tripas').open && !tripasPintadas) { tripasPintadas = true; pintarTripas(); }
  });

  // ── Lo que va mal ───────────────────────────────────────────────────────
  // Sólo lo GRAVE, que ahora significa: resistió a arreglarse solo. Lo demás —un
  // trabajo que falló y se relanzó, una fuente pausada— lo resuelve el vigilante
  // sin contarlo. Enterarse de un fallo que ya está arreglado no es información,
  // es ruido, y el ruido enseña a ignorar el aviso que sí importa.
  async function pintarIncidencias() {
    const d = await api('incidencias');
    const el = $('inc-lista');
    const graves = (d.incidencias || []).filter(i => i.gravedad === 'grave');
    if (d.error || !graves.length) { el.innerHTML = ''; return; }
    el.innerHTML = `<div class="admin-msg" style="margin-bottom:30px">
      ${graves.map(i => {
        const dias = Math.round((Date.now() - new Date(i.created_at)) / 864e5);
        return `<div style="margin-bottom:6px">
          ${i.gravedad === 'grave' ? '<strong>' : ''}${esc(i.sujeto || i.clase.replace(/_/g, ' '))}${
            i.gravedad === 'grave' ? '</strong>' : ''} — ${esc(i.detalle)}
          ${i.accion ? `<span class="admin-nota"> · ${esc(i.accion)}</span>` : ''}
          ${dias >= 1 ? `<span class="admin-nota"> · desde hace ${dias}d</span>` : ''}
          <button class="admin-btn sec" data-inc="${i.id}">dismiss</button></div>`;
      }).join('')}</div>`;
  }

  delegar($('inc-lista'), '[data-inc]', async (b) => {
    b.disabled = true;
    await api('incidencias.cerrar', { id: b.dataset.inc });
    pintarIncidencias();
  });

  // ── Esta semana ─────────────────────────────────────────────────────────
  // Cada número contesta UNA pregunta, y todos miran la misma ventana que usará
  // el corte. Los que había antes no servían: «446 picked up this week» sumaba
  // lo leído, lo que esperaba y 155 descartados por duración —tres cosas en un
  // número—; «225 read in total» contaba desde el principio de los tiempos; y
  // «78 topics alive» eran todos los temas que han existido, de los que 75 eran
  // de esa misma semana.
  async function pintarCifras() {
    const e = await api('status');
    const el = $('st-cifras'), nota = $('st-corte');
    if (e.error) { el.innerHTML = `<span class="admin-vacio">${esc(e.error)}</span>`; return; }

    const cifra = (n, t, acento) => `<div class="admin-cifra"><b${
      acento ? ' style="color:var(--accent)"' : ''}>${esc(n)}</b><span>${esc(t)}</span></div>`;

    // «81 por leer» no dice si esperar; «81 · ~7 h» sí. La estimación sale del
    // ritmo real de las últimas seis horas, no de una constante.
    const porLeer = Number(e.por_leer || 0);
    const ritmo = Number(e.ritmo || 0);
    const horas = porLeer && ritmo ? Math.ceil(porLeer / ritmo) : 0;

    // Cuánto falta para que la semana EN CURSO cierre sola. Es la cifra que dice
    // si tiene sentido cortar a mano: a dos horas del cierre, esperar; a cuatro
    // días, no. Antes miraba la semana que acababa de cerrarse y el domingo
    // entero decía «closing now» —el cierre ya había pasado— sobre una semana
    // terminada, mientras la nueva llevaba horas acumulando material.
    const faltaMs = new Date(e.hasta).getTime() - Date.now();
    const d = Math.floor(faltaMs / 864e5);
    const h = Math.floor((faltaMs % 864e5) / 36e5);
    const cierre = faltaMs <= 0 ? 'now' : d ? `${d}d ${h}h` : `${h}h`;

    el.innerHTML =
        cifra(cierre, 'until this week closes')
      + cifra(porLeer ? `${porLeer} · ~${horas} h` : '0', 'still to read', porLeer > 0)
      + cifra(e.listos || 0, 'ready for the issue')
      + cifra(`${e.reportaje || 0}${e.buscados ? ` / ${e.buscados}` : ''}`,
              e.sin_nada ? `outside reports · nothing for ${e.sin_nada}` : 'outside reports')
      + cifra(`${e.fuentes || 0}${e.calladas ? ` · ${e.calladas}` : ''}`,
              e.calladas ? 'sources · quiet 2 weeks' : 'sources')
      + ((e.con_error || 0) ? cifra(e.con_error, 'failed', true) : '');

    // Y debajo, en una línea, lo único que hay que decidir con esos números.
    // `hasta` es EXCLUSIVO — el primer instante que ya no entra—; el último día
    // del número es la víspera. Pintado tal cual decía «08/16–08/23» para un
    // número que cubre hasta el 22: la línea que existe para decidir el corte
    // nombraba un día que no está en él.
    // En hora de Los Ángeles, que es donde vive la semana. Con `toISOString` la
    // víspera se pintaba con la fecha UTC y podía salir un día corrido.
    const dia = (t) => new Date(t).toLocaleDateString('en-CA',
      { timeZone: 'America/Los_Angeles', month: '2-digit', day: '2-digit' }).replace('-', '/');
    const ventana = `${dia(e.desde)}–${dia(new Date(e.hasta).getTime() - 864e5)}`;
    // Lo lanzado se recuerda FUERA de este HTML: la nota se repinta con cada
    // refresco y un botón recién pintado es un botón rearmado — apretar «Cut
    // now» dos veces encola dos corridas de Kimi de 15 minutos, y las dos se
    // pagan.
    const marca = (id, texto) => lanzado[id]
      ? `<span class="admin-kind">${esc(texto)}</span>`
      : '';
    // Y debajo, el estado del último número: qué es, si salió y si tiene español.
    const u = e.ultimo;
    const linea = u
      ? `Last issue · <b>${esc(u.titular || u.semana)}</b> · ${esc(u.estado)}` +
        `${u.espanol ? ' · ES' : ' · <span style="color:var(--accent)">no ES</span>'}` +
        ` · <a href="/weekly/${esc(u.semana)}/" target="_blank" rel="noopener">read</a><br>`
      : '';
    nota.innerHTML = linea + (e.listos
      ? `Issue for <b>${esc(ventana)}</b>${e.parcial ? ' (week still open)' : ''} would use ` +
        `<b>${esc(e.listos)}</b>${porLeer ? `, leaving <b>${esc(porLeer)}</b> still unread out` : ''}` +
        `${e.rezagados ? `, plus <b>${esc(e.rezagados)}</b> carried over from before` : ''}. ` +
        (lanzado.corte ? marca('corte', 'cut launched · ~15 min') :
          `<button class="admin-btn sec" id="st-cortar">Cut now</button>`)
      : (porLeer ? `Nothing read yet this week; <b>${esc(porLeer)}</b> waiting. ` : 'Nothing read yet this week.'))
      + (porLeer && e.listos !== undefined
          ? (lanzado.cola ? ' ' + marca('cola', 'queue reading · reload in a few min')
                          : ` <button class="admin-btn sec" id="st-cola">Read the queue first</button>`)
          : '');
  }

  // El corte lo escribe un Action porque el modelo tarda ~15 min; esto solo
  // aprieta el botón. Es el mismo que el de la pestaña Weekly.
  // Qué se ha lanzado ya en esta visita. Vive a nivel de módulo porque la nota
  // se repinta y cualquier estado guardado en su HTML se pierde con ella.
  const lanzado = { corte: 0, cola: 0 };

  delegar($('st-corte'), '#st-cortar', async (b) => {
    b.disabled = true; b.textContent = 'launching…';
    const r = await api('weekly.rebuild');
    if (r.error) { b.disabled = false; b.textContent = `failed: ${String(r.error).slice(0, 40)}`; return; }
    lanzado.corte = 1; b.textContent = 'launched · ~15 min';
  });

  // El radar lee ~2 episodios cada 15 min porque eso es lo que cabe en una edge
  // function. Esto llama a la misma función seguida, con pausa entre vueltas.
  delegar($('st-corte'), '#st-cola', async (b) => {
    b.disabled = true; b.textContent = 'reading…';
    const r = await api('queue.drain');
    if (r.error) { b.disabled = false; b.textContent = `failed: ${String(r.error).slice(0, 40)}`; return; }
    lanzado.cola = 1; b.textContent = 'reading · reload in a few min';
  });

  async function pintarTripas() {
    if (!tripasPintadas) return;
    const [g, c, con, s] = await Promise.all([
      api('budget'), api('cotejos.list'), api('consejo.list'), api('settings.get')]);

    if (!g.error && g.uso?.length) {
      const V = { gemini: ['hoy', 'cap_gemini_dia', '/day'], youtube: ['hoy', 'cap_youtube_dia', '/day'],
                  tavily: ['mes', 'cap_tavily_mes', '/mo'] };
      $('st-gasto').textContent = g.uso.map(u => u.proveedor === 'moonshot'
        ? `kimi $${Number(u.coste_mes).toFixed(2)}/mo`
        : `${u.proveedor} ${u[(V[u.proveedor] || ['mes'])[0]]}${
            V[u.proveedor]?.[1] && g.topes[V[u.proveedor][1]] ? `/${g.topes[V[u.proveedor][1]]}` : ''}${
            (V[u.proveedor] || [, , '/mo'])[2]}`).join('  ·  ');
    }
    // ── El cupo, y los mandos para moverlo ────────────────────────────────
    //
    // Lo que se enseña no es «cuánto llevamos gastado» sino «cuánto queda y a
    // dónde va». La cifra de Tavily la anota el guion del reportaje al pasar,
    // así que se dice cuándo se vio: un número de hace nueve días no es el cupo,
    // es el cupo de hace nueve días.
    if (!g.error && g.tavily) {
      const t = g.tavily;
      const edad = Math.floor((Date.now() - new Date(t.visto)) / 3600e3);
      $('st-cupo').innerHTML =
        `<strong>${t.restantes} of ${t.tope} Tavily credits left</strong> · renews in ${t.dias_para_renovar} d · ` +
        `${t.busquedas_semana} searches allotted this week · ${t.otros_por_semana}/wk goes to cross-checks and monitors` +
        `<span class="admin-tenue"> — seen ${edad < 1 ? 'just now' : edad + ' h ago'}</span>`;
    } else if (!g.error) {
      $('st-cupo').textContent = 'Tavily quota not read yet — it is recorded by the reporting job when it runs.';
    }

    if (!c.error) {
      const n = {};
      for (const x of c.cotejos) n[x.verdict] = (n[x.verdict] || 0) + 1;
      $('st-cotejo').textContent = c.cotejos.length
        ? `Cross-checks: ${Object.entries(n).map(([k, v]) => `${v} ${k}`).join(' · ')}`
        : 'No claims cross-checked yet.';
    }
    if (!con.error) {
      const activas = Object.entries(con.ranuras || {}).filter(([, v]) => v && String(v).trim());
      $('con-lista').innerHTML = activas.length
        ? `<div class="admin-msg">${activas.map(([k, v]) =>
            `<strong>Correction in force</strong> (${esc(k.replace('prompt_calibracion_', ''))}): ${esc(v)}
             <button class="admin-btn sec" data-rev="${esc(
               (con.deliberaciones.find(x => x.aplicado && x.ranura === k) || {}).id || '')}"
               data-ran="${esc(k)}">revert</button>`).join('<br>')}</div>`
        : `<p class="admin-nota">No correction in force · ${con.deliberaciones.length} committee session(s)</p>`;
    }
    $('st-auto').checked = s.settings?.auto_publish === true;
  }

  delegar($('con-lista'), '[data-rev]', async (b) => {
    if (!confirm('Revert this correction?')) return;
    b.disabled = true;
    const r = await api('consejo.revertir', { id: b.dataset.rev, ranura: b.dataset.ran });
    msg(cajaMsg, r.error || 'Reverted.', !r.error);
    pintarTripas();
  });

  $('st-auto').onchange = async (e) => {
    const r = await api('settings.set', { key: 'auto_publish', value: e.target.checked });
    msg(cajaMsg, r.error || (e.target.checked
      ? 'The weekly issue will go out without review.' : 'The weekly issue will wait for you.'), !r.error);
  };

  pintarIncidencias(); pintarCifras(); pintarCola(); pintarFuentes();
</script>
</AdminLayout>
