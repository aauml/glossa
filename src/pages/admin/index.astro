---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Status" tab="status">

  <h1>Status</h1>
  <p class="sub">What the radar is watching and how much it has processed. None of this gets published — it is reading material.</p>

  <div class="admin-sec">
    <h2>Right now</h2>
    <div class="admin-cifras" id="cifras"><span class="admin-vacio">loading…</span></div>
  </div>

  <div class="admin-sec">
    <h2>Automatic publishing</h2>
    <p class="sub" style="margin-bottom:14px">
      Off, the weekly issue waits here and you publish it yourself. On, it goes out on its own.
      Best decided <em>after</em> seeing the first issue.
    </p>
    <label style="display:flex;gap:9px;align-items:center;font-size:13px">
      <input type="checkbox" id="auto" /> Publish the weekly issue without review
    </label>
  </div>

<script>
  const api = (op, extra = {}) => fetch('/api/admin/op/', { method: 'POST',
    headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ op, ...extra }) }).then(r => r.json());
  const esc = s => String(s ?? '').replace(/[<>&"]/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;'}[c]));
  const msg = (id, t, ok) => { document.getElementById(id).innerHTML = `<div class="admin-msg ${ok?'ok':''}">${esc(t)}</div>`; };
  api('status').then(d => {
    const c = document.getElementById('cifras');
    if (d.error) { c.innerHTML = `<span class="admin-vacio">${d.error}</span>`; return; }
    const it = d.items || {};
    const cifra = (n, t) => `<div class="admin-cifra"><b>${n}</b><span>${t}</span></div>`;
    c.innerHTML = cifra(`${d.sources.active}/${d.sources.total}`, 'active sources')
      + cifra(it.digested || 0, 'episodes processed')
      + cifra(it.pending || 0, 'queued')
      + cifra(d.topics || 0, 'live topics')
      + ((it.error || 0) ? cifra(it.error, 'with errors') : '');
  });
  const auto = document.getElementById('auto');
  api('settings.get').then(d => { auto.checked = d.settings?.auto_publish === true; });
  auto.addEventListener('change', () => api('settings.set', { key: 'auto_publish', value: auto.checked }));
</script>
</AdminLayout>
