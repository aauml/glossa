---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Fuentes" tab="fuentes">
  <h1>Fuentes</h1>
  <p class="sub">
    Canales de YouTube, podcasts y medios que el radar revisa cada noche.
    Se comprueba que el feed responda antes de guardarlo: una fuente rota que falla
    en silencio cada noche es peor que un error ahora.
  </p>

  <div class="admin-sec">
    <h2>Añadir</h2>
    <div id="msg"></div>
    <form class="admin-form" id="alta">
      <label>
        Enlace del feed
        <input name="feed_url" placeholder="https://…/feed.xml  ·  o el enlace del canal de YouTube" required />
      </label>
      <div class="admin-row">
        <label style="flex:1">
          Tipo
          <select name="kind">
            <option value="youtube">Canal de YouTube</option>
            <option value="podcast">Podcast</option>
            <option value="rss">Medio escrito</option>
          </select>
        </label>
        <label style="flex:2">
          Nombre <span style="opacity:.6">(si lo dejas vacío se toma del feed)</span>
          <input name="name" />
        </label>
      </div>
      <label>
        Nota <span style="opacity:.6">— p. ej. su orientación editorial, para que el análisis la tenga en cuenta</span>
        <input name="notes" />
      </label>
      <div class="admin-row">
        <button class="admin-btn" type="submit">Añadir</button>
        <button class="admin-btn sec" type="button" id="probar">Solo probar el feed</button>
      </div>
    </form>
  </div>

  <div class="admin-sec">
    <h2>Vigilando</h2>
    <div id="lista"><span class="admin-vacio">cargando…</span></div>
  </div>

  <script>
    const api = (op, extra = {}) =>
      fetch('/api/admin/op/', { method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op, ...extra }) }).then(r => r.json());
    const esc = s => String(s ?? '').replace(/[<>&"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c]));
    const msg = (t, ok) => { document.getElementById('msg').innerHTML = `<div class="admin-msg ${ok ? 'ok' : ''}">${esc(t)}</div>`; };

    // El enlace de un canal de YouTube no es su feed. Se resuelve aquí para que
    // no haya que saberse la URL del RSS.
    function normalizar(url, kind) {
      if (kind !== 'youtube') return url;
      const m = /youtube\.com\/channel\/(UC[\w-]+)/.exec(url);
      if (m) return `https://www.youtube.com/feeds/videos.xml?channel_id=${m[1]}`;
      return url;
    }

    async function pintar() {
      const d = await api('sources.list');
      const el = document.getElementById('lista');
      if (d.error) { el.innerHTML = `<span class="admin-vacio">${esc(d.error)}</span>`; return; }
      if (!d.sources.length) { el.innerHTML = '<span class="admin-vacio">Todavía no hay ninguna fuente.</span>'; return; }
      el.innerHTML = `<table class="admin-tabla"><thead><tr>
          <th>Nombre</th><th>Tipo</th><th>Feed</th><th>Revisado</th><th></th></tr></thead><tbody>` +
        d.sources.map(s => `<tr class="${s.active ? '' : 'off'}">
          <td><strong>${esc(s.name)}</strong>${s.notes ? `<div class="admin-nota">${esc(s.notes)}</div>` : ''}</td>
          <td><span class="admin-kind">${esc(s.kind)}</span></td>
          <td class="admin-url">${esc(s.feed_url)}</td>
          <td style="white-space:nowrap;color:var(--muted)">${s.last_checked_at ? esc(s.last_checked_at.slice(0, 10)) : '—'}</td>
          <td style="white-space:nowrap">
            <button class="admin-btn sec" data-t="${s.id}" data-a="${s.active ? '0' : '1'}">${s.active ? 'Pausar' : 'Activar'}</button>
            <button class="admin-btn sec" data-d="${s.id}" data-n="${esc(s.name)}">Quitar</button>
          </td></tr>`).join('') + '</tbody></table>';

      el.querySelectorAll('[data-t]').forEach(b => b.onclick = async () => {
        await api('sources.toggle', { id: b.dataset.t, active: b.dataset.a === '1' }); pintar();
      });
      el.querySelectorAll('[data-d]').forEach(b => b.onclick = async () => {
        if (!confirm(`¿Quitar «${b.dataset.n}»? Los episodios ya digeridos se borran con ella.`)) return;
        await api('sources.delete', { id: b.dataset.d }); pintar();
      });
    }

    document.getElementById('probar').onclick = async () => {
      const f = document.getElementById('alta');
      const url = normalizar(f.feed_url.value.trim(), f.kind.value);
      msg('comprobando…', true);
      const r = await api('sources.check', { feed_url: url });
      msg(r.ok ? `Responde bien: «${r.nombre || 'sin título'}»` : r.error, r.ok);
    };

    document.getElementById('alta').onsubmit = async (e) => {
      e.preventDefault();
      const f = e.target, btn = f.querySelector('button[type=submit]');
      btn.disabled = true; msg('comprobando el feed…', true);
      const r = await api('sources.create', {
        feed_url: normalizar(f.feed_url.value.trim(), f.kind.value),
        kind: f.kind.value, name: f.name.value.trim(), notes: f.notes.value.trim(),
      });
      btn.disabled = false;
      if (r.error) { msg(r.error, false); return; }
      msg(`Añadida: ${r.source.name}`, true); f.reset(); pintar();
    };

    pintar();
  </script>
</AdminLayout>
