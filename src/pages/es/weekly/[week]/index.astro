---
export const prerender = false;
import '../../../../styles/fonts.css';   // sin esto, Fraunces y Spectral caen a Georgia
import WeeklyMasthead from '../../../../components/WeeklyMasthead.astro';
import PrefsHead from '../../../../components/PrefsHead.astro';
import PrefsBody from '../../../../components/PrefsBody.astro';
import '../../../../styles/global.css';
import '../../../../styles/weekly.css';
import { renderIssue, fecha } from '../../../../lib/weekly.js';

const { week } = Astro.params;

// Lee con la llave pública, no con la de servicio. La política de la migración
// 0018 sólo deja ver las filas publicadas, así que un borrador devuelve 404 aquí
// aunque alguien acierte la URL. La compuerta vive en la base, no en esta página.
const URL_SB = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL;
const ANON = import.meta.env.SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY;

// Un 404 significa «ese número no existe o no está publicado». Cuando falta la
// configuración, la página NO puede saber eso — y devolvía 404 igualmente, que
// es afirmar algo que no comprobó. Pasó con el primer número publicado de la
// historia: existía, estaba publicado, y su URL decía que no.
if (!URL_SB || !ANON) {
  console.error('[weekly] falta SUPABASE_URL o SUPABASE_ANON_KEY en el entorno del despliegue');
  return new Response('The site cannot reach its archive right now. This is a fault here, not a missing issue.',
                      { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

let issue = null;
if (/^\d{4}-\d{2}-\d{2}$/.test(week ?? '')) {
  const r = await fetch(
    `${URL_SB}/rest/v1/glossa_radar_weekly?select=week_start,week_end,body,body_es,state&week_start=eq.${week}&state=eq.publicado`,
    { headers: { apikey: ANON, Authorization: `Bearer ${ANON}` } });
  if (r.ok) issue = (await r.json())[0] ?? null;
  else {
    console.error(`[weekly] la base respondió ${r.status}`);
    return new Response('The site cannot reach its archive right now.',
                        { status: 503, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
  }
}
if (!issue) return new Response(null, { status: 404 });

const b = issue.body ?? {};
// Si la traducción no existe todavía —falló, o el número es anterior a que
// existiera— se dice y se ofrece el inglés. Servir el inglés bajo una URL /es/
// sin avisar sería hacer pasar una cosa por otra.
const bEs = issue.body_es ?? null;
if (!bEs) return Astro.redirect(`/weekly/${week}/?sin-traduccion=1`, 302);
// El título, la descripción y las etiquetas sociales salen del cuerpo EN
// ESPAÑOL. Salían del inglés: la pestaña del navegador, el resultado de
// búsqueda y la tarjeta al compartir iban en inglés sobre una página cuyo
// titular estaba traducido. `bEs` ya existe tres líneas más arriba.
const bMeta = bEs;
const titulo = bMeta.headline ?? b.headline ?? 'Número semanal';
const entradilla = (bMeta.standfirst ?? b.standfirst ?? '').slice(0, 180);
const desde = fecha(issue.week_start, 'es'), hasta = fecha(issue.week_end, 'es');
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{titulo} · Glossa</title>
  <meta name="description" content={entradilla}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={`https://glossa.ademas.ai/es/weekly/${issue.week_start}/`} />
  {/* Las dos ediciones se declaran alternativas la una de la otra. Antes la
      página española se declaraba CANÓNICA a la inglesa, que es decirle al
      buscador «esto es un duplicado, indexa la otra»: la edición en español
      —que se traduce a propósito y se localiza a México (D-020)— quedaba
      invisible en las búsquedas. Son dos ediciones, no una copia. */}
  <link rel="alternate" hreflang="en" href={`https://glossa.ademas.ai/weekly/${issue.week_start}/`} />
  <link rel="alternate" hreflang="es" href={`https://glossa.ademas.ai/es/weekly/${issue.week_start}/`} />
  <link rel="alternate" hreflang="x-default" href={`https://glossa.ademas.ai/weekly/${issue.week_start}/`} />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={entradilla} />
  <PrefsHead />
</head>
<body>
  <WeeklyMasthead lang="es" otro={`/weekly/${week}/`} />

  <!-- La marca de edición. Es lo único que separa la revista de un artículo:
       misma tipografía, mismo fondo, mismos tamaños — pero con el filete y la
       cabecera de un número, que se reconocen al instante sin parecer otro
       sitio. -->
  <div class="weekly-marca">
    <div class="weekly-marca-inner">
      <span class="weekly-marca-tag">Semanal</span>
      <span class="weekly-marca-fechas">{desde} – {hasta}
        <a class="weekly-marca-idioma" href={`/weekly/${week}/`}>English</a></span>
    </div>
  </div>

  <main class="weekly" set:html={renderIssue(bEs, 'es')} />
  <a href="#contents" id="weekly-top" aria-label="Volver al índice">↑</a>

  <script is:inline>
    (function () {
      var b = document.getElementById('weekly-top'), i = document.getElementById('contents');
      if (!b || !i) return;
      if (!('IntersectionObserver' in window)) { b.classList.add('on'); return; }
      new IntersectionObserver(function (e) {
        b.classList.toggle('on', !e[0].isIntersecting && e[0].boundingClientRect.top < 0);
      }, { threshold: 0 }).observe(i);
    })();
  </script>
  <PrefsBody />
</body>
</html>
