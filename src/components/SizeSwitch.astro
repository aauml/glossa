---
// UN botón que cicla pequeño → medio → grande, no tres.
//
// Los tres «A A A» ocupaban tres objetivos táctiles de la cabecera para una
// preferencia que casi nadie toca dos veces, y en móvil eran la mitad del
// amontonamiento. Ciclar tiene el coste de un toque de más para llegar al
// extremo lejano; a cambio devuelve dos huecos a una barra que no los tenía.
//
// El tamaño actual se ve en la propia letra del botón —crece con él— y se dice
// en `title`, que es lo que un lector necesita para saber dónde está.
const { separator = false } = Astro.props;
---
{separator && <span class="masthead-meta-sep">·</span>}
<button class="text-size-switch" type="button" data-size-cycle
        aria-label="Text size" title="Text size">A</button>
