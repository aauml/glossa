---
// La página que recoge lo que la portada dejó de decir.
//
// La portada se quedó con una frase —qué es Glossa— porque eso es lo que hay
// que entender en una respiración. Todo lo demás (la hebra de la tesis, quién
// hace qué, por qué las fuentes se cotejan, y cómo pedir acceso) vive aquí, que
// es donde va quien ya quiso saber más.
const { lang } = Astro.props;

const COPY = {
  en: {
    titulo: 'About',
    intro: 'Glossa is my editor. I give it links, pasted text, YouTube videos, podcasts, outlets, authors and subjects to follow — and the papers, books and source documents in my library; it reads them, checks what they claim against other outlets, other countries and the record, and writes back one reading: no ads, no side taken.',
    bloques: [
      { h: 'Two strands',
        p: ['The weekly is one. It follows the channels, podcasts and outlets I choose, groups the week by subject, and then goes out to look for the same story in other countries and other languages — reporting, not commentary, and the text itself rather than a headline.',
            'The second strand is for a thesis: books, essays and source documents from the library I built for it. Same method, steadier ground — these are the readings I study from.'] },
      { h: 'What "checked" means here',
        p: ['Every claim carries how it is held up: asserted by whoever said it, attributed to someone else, or documented against a record you can go and read. Agreement is not corroboration — five voices from the same school repeating each other is one account, and the piece says so.',
            'Sources are listed at the foot of every reading, with what each one supports.'] },
      { h: 'Who does what',
        p: ['The ideas and the direction are mine; the searching, checking and writing are the machine’s. Grounded, not invented.'] },
      { h: 'Want a Glossa of your own?',
        p: ['This runs on a small budget and a lot of care, and opening it up takes both. If you want your own — your sources, your subjects, your reading — get in touch and I will set you up as places open.'] },
    ],
    contacto: 'Get in touch',
    volver: '← Glossa',
  },
  es: {
    titulo: 'Acerca de',
    intro: 'Glossa es mi editor. Le doy enlaces, textos pegados, vídeos de YouTube, pódcast, medios, autores y asuntos que seguir, y los papers, libros y documentos de mi biblioteca; los lee, contrasta lo que afirman con otros medios, otros países y el registro, y me devuelve una sola lectura: sin anuncios y sin tomar partido.',
    bloques: [
      { h: 'Dos hebras',
        p: ['El semanal es una. Sigue los canales, pódcast y medios que elijo, agrupa la semana por asuntos y luego sale a buscar la misma historia en otros países y otras lenguas: reporteo, no opinión, y el texto entero en vez de un titular.',
            'La segunda hebra es para una tesis: libros, ensayos y documentos de origen de la biblioteca que construí para ella. El mismo método sobre terreno más firme; son las lecturas con las que estudio.'] },
      { h: 'Qué significa aquí «contrastado»',
        p: ['Cada afirmación lleva con qué se sostiene: afirmada por quien la dijo, atribuida a un tercero, o documentada contra un registro que se puede ir a leer. Coincidir no es corroborar: cinco voces de la misma escuela repitiéndose son un solo relato, y la pieza lo dice.',
            'Las fuentes van al pie de cada lectura, con lo que respalda cada una.'] },
      { h: 'Quién hace qué',
        p: ['Las ideas y la dirección son mías; buscar, verificar y redactar lo hace la máquina. Fundamentado, no inventado.'] },
      { h: '¿Quieres tu propia Glossa?',
        p: ['Esto funciona con un presupuesto pequeño y mucho cuidado, y abrirlo cuesta las dos cosas. Si quieres la tuya —tus fuentes, tus asuntos, tus lecturas— escríbeme y te daré acceso conforme haya sitio.'] },
    ],
    contacto: 'Escríbeme',
    volver: '← Glossa',
  },
};
const t = COPY[lang];
const inicio = lang === 'es' ? '/es/' : '/';
// El contacto vive en ademas.ai, en su sección «About me». Esa vista se dibuja
// con JavaScript y NO tiene URL propia —comprobado: cualquier ruta del sitio
// devuelve la misma página—, así que el enlace lleva al sitio, no a la sección.
// Si algún día esa sección gana su propia dirección, se cambia aquí y ya.
const CONTACTO = 'https://ademas.ai/';
---
<section class="cover">
  <div class="cover-head">
    <h1 class="cover-wordmark about-titulo">{t.titulo}</h1>
    <div class="cover-intro">
      <p class="cover-why">{t.intro}</p>
      <a class="cover-acceso" href={inicio}>{t.volver}</a>
    </div>
  </div>
</section>

<section class="contents">
  {t.bloques.map(b => (
    <div class="about-bloque">
      <div class="about-rail">{b.h}</div>
      <div class="about-cuerpo">
        {b.p.map(x => <p>{x}</p>)}
      </div>
    </div>
  ))}
  <div class="about-bloque">
    <div class="about-rail"></div>
    <div class="about-cuerpo">
      <a class="about-contacto" href={CONTACTO} rel="noopener">{t.contacto}</a>
    </div>
  </div>
</section>
