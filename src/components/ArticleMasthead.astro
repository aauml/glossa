---
import SizeSwitch from './SizeSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
// `langs` son los idiomas que existen para esta pieza. Un idioma ausente se
// pinta apagado en vez de enlazar a una página que no se genera.
const { lang, slug, langs = ['en', 'es'] } = Astro.props;
const LABEL = { en: 'EN', es: 'ES' };
const ORDER = ['en', 'es'];
---
<header class="masthead">
  <div class="masthead-inner">
    <a class="masthead-section masthead-brand" href="/" style="font-size:14px">← Glossa</a>
    <span class="masthead-meta">
      {/* Solo la OTRA lengua. Si esa pieza no existe traducida, se pinta
          apagada en vez de enlazar a una página que no se genera. */}
      {ORDER.filter(code => code !== lang).map(code => (
        langs.includes(code)
          ? <a href={`/articles/${slug}/${code}/`} class="lang-link" hreflang={code}>{LABEL[code]}</a>
          : <span class="lang-absent" title={code === 'es' ? 'Sin versión en español' : 'No English version'}>{LABEL[code]}</span>
      ))}
      <SizeSwitch separator />
      <ThemeSwitch separator />
    </span>
  </div>
</header>
