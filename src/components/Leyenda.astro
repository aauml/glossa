---
/**
 * Qué significan las marcas del texto, en una pieza.
 *
 * Existía solo en la revista. Cuando la voz de las piezas dejó de repartir
 * atribuciones en cada frase —«el autor describe», «el columnista sostiene»— y
 * pasó a afirmar, la marca se volvió lo único que dice cuánto sostiene cada
 * afirmación. Sin esta leyenda, un subrayado dorado es un subrayado dorado.
 */
const { lang = 'en' } = Astro.props;
// Las marcas describen el respaldo registrado. No prueban una búsqueda
// exhaustiva ni permiten deducir falsedad o verificación de lo no marcado.
const T = lang === 'es'
  ? { titulo: 'Las marcas indican el respaldo registrado. Una frase sin marca puede seguir pendiente de verificación.',
      doc: 'respaldo documental indicado',
      attr: 'atribuido a una fuente; corroboración independiente no indicada',
      said: 'afirmación sin respaldo verificado indicado',
      n: { doc: 'dorado', attr: 'punteado', said: 'liso' } }
  : { titulo: 'Marks show recorded support. An unmarked sentence may still need verification.',
      doc: 'documentary support indicated',
      attr: 'attributed to a source; independent corroboration not indicated',
      said: 'claim without indicated verified support',
      n: { doc: 'gold', attr: 'dotted', said: 'plain' } };
---
<div class="legend legend-articulo">
  <b>{T.titulo}</b>
  <span><span class="doc">{T.n.doc}</span> {T.doc}</span>
  <span><span class="attr">{T.n.attr}</span> {T.attr}</span>
  <span><span class="said">{T.n.said}</span> {T.said}</span>
</div>
