---
import { fecha, rango } from '../lib/weekly.js';
import { articlesByLang, topTopics } from '../lib/collection.js';

// Portada compartida por las dos lenguas. Antes solo existía en inglés y la
// lógica vivía inline en index.astro, así que una portada española habría sido
// una copia condenada a divergir.
const { lang } = Astro.props;

const COPY = {
  en: {
    news: 'Glossa is my editor. Every week it reads the writers, sites, podcasts and videos I follow, and on Sunday it writes back what happened, checked against other outlets, showing what is solid and what only one source claims. Paste an article or name a subject and it writes that one too, in the voice and the length I like to read, which I keep tuning piece by piece. No ads, no side taken.',
    subT: 'Own your own',
    subP: 'Your sources, your subjects, and a voice you tune until it reads the way you like. Leave your email and I will write back when there is a place.',
    subPlaceholder: 'your@email',
    subBoton: 'Ask for one',
    all: 'All',
    piece: 'piece',
    pieces: 'pieces',
    featured: 'Most recent',
    empty: 'No pieces under that topic yet.',
    footer: 'Personal · No ads · No tracking',
    weekly: {
      tag: 'Every Sunday',
      thisWeek: 'This week',
      latest: 'Latest issue',
      title: 'The Weekly',
      archivo: 'Every issue',
    },
    other: { code: 'es', label: 'ES', href: '/es/' },
  },
  es: {
    news: 'Glossa es mi editor. Cada semana lee a los autores, sitios, pódcast y videos que sigo, y el domingo me escribe qué pasó, contrastado con otros medios, señalando qué está firme y qué lo dice una sola fuente. Pégale un artículo o dile un tema y también lo escribe, con la voz y el largo que me gusta leer, que voy afinando pieza a pieza. Sin anuncios y sin tomar partido.',
    subT: 'Ten la tuya',
    subP: 'Tus fuentes, tus temas y una voz que vas afinando hasta que se lee como te gusta. Deja tu correo y te escribo en cuanto haya sitio.',
    subPlaceholder: 'tu@correo',
    subBoton: 'Pedir la mía',
    all: 'Todos',
    piece: 'pieza',
    pieces: 'piezas',
    featured: 'Lo más reciente',
    empty: 'Todavía no hay piezas con ese tema.',
    footer: 'Personal · Sin anuncios · Sin rastreo',
    weekly: {
      tag: 'Cada domingo',
      thisWeek: 'Esta semana',
      latest: 'Último número',
      title: 'El semanal',
      archivo: 'Todos los números',
    },
    other: { code: 'en', label: 'EN', href: '/' },
  },
};

const t = COPY[lang];

// ── El número que hay ahora mismo ────────────────────────────────────────
//
// Se lee en vivo, no al construir: publicar un número cambia una fila de la
// base y no hace commit, así que una portada prerenderizada anunciaría el
// número de hace tres semanas hasta el siguiente despliegue.
//
// Y va envuelto en su propio try con temporizador: esto es un adorno de la
// portada. Si la base no contesta, el bloque se queda como estaba —etiqueta,
// título y entradilla— y la página principal sale igual. Un teaser no puede
// tumbar la portada.
let ultimo = null;
try {
  const URL_SB = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL;
  const ANON   = import.meta.env.SUPABASE_ANON_KEY || process.env.SUPABASE_ANON_KEY;
  if (URL_SB && ANON) {
    const r = await fetch(
      `${URL_SB}/rest/v1/glossa_radar_weekly?select=week_start,week_end,body,body_es` +
      `&state=eq.publicado&order=week_start.desc&limit=1`,
      { headers: { apikey: ANON, Authorization: `Bearer ${ANON}` },
        signal: AbortSignal.timeout(4000) });
    if (r.ok) [ultimo = null] = await r.json();
  }
} catch { ultimo = null; }

// Los temas son el campo `subject` de cada pieza —«Iran sanctions», «Strait of
// Hormuz», «Mexico politics»—, no su titular.
//
// El titular está escrito para intrigar: «The Squeeze and the Squeezed», «Who
// Counts the Barrels». Puestos en fila en la portada no dicen de qué va el
// número; el `subject` sí, en dos palabras y de un vistazo, que es justo lo que
// se le pide a un apunte discreto. Los titulares ya esperan dentro.
const cuerpo = ultimo && (lang === 'es' ? (ultimo.body_es || ultimo.body) : ultimo.body);
const tituloNumero = String(cuerpo?.headline ?? '').trim() || null;
const temas = ((cuerpo?.pieces) ?? [])
  .map(p => String(p?.subject ?? p?.title ?? '').trim())
  .filter(Boolean)
  .slice(0, 6);
// El rango que cubre, no el domingo suelto: un número trae siete días.
const fechaNumero = ultimo ? rango(ultimo.week_start, ultimo.week_end, lang) : null;

// ¿El número que hay es el de ESTA semana o el de la pasada? La portada decía
// «cada domingo · 16 de agosto» un día 24, y quien lo leía no podía saber si el
// sitio estaba parado o si simplemente aún no había cortado. El rótulo lo dice.
// La semana se ancla al domingo en hora de Los Ángeles, como en todo el sistema.
const hoyLA = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Los_Angeles' }));
const domingoLA = new Date(hoyLA);
domingoLA.setDate(hoyLA.getDate() - hoyLA.getDay());
const esDeEstaSemana = !!ultimo && ultimo.week_start === domingoLA.toISOString().slice(0, 10);
const hrefArchivo = lang === 'es' ? '/es/weekly/archive/' : '/weekly/archive/';

const articles = await articlesByLang(lang);
const topics = topTopics(articles);
const [featured, ...rest] = articles;
const keyOf = (a) => (a.data.topics || []).join('|');
const href = (a) => `/articles/${a.slug}/${lang}/`;
---
{/* La cabecera de un periódico: el nombre a todo lo ancho, entre filetes, con
    la fecha del número a su derecha; y debajo, en dos columnas, qué es esto y
    la única oferta que hay.

    Antes el nombre vivía SOLO en una columna de media portada y el párrafo en
    la otra, así que la mitad de arriba era papel en blanco alrededor de una
    palabra. Un nombre manda por tamaño y por posición, no por soledad. */}
<section class="cover">
  <div class="cover-nameplate">
    <h1 class="cover-wordmark">Glossa<span class="wm-dot">.</span></h1>
    {fechaNumero && <span class="cover-fecha">{fechaNumero}</span>}
  </div>

  <div class="cover-head">
    <p class="cover-why">{t.news}</p>

    {/* UNA sola oferta: tener la tuya. La suscripción al semanal queda para
        otra etapa —el camino está montado y probado en la función, solo no se
        expone—; ofrecer las dos a la vez obligaba al lector a elegir entre
        dos cosas que suenan igual antes de haber leído nada. */}
    <div class="sub-caja">
      <span class="sub-rail">{t.subT}</span>
      <p class="sub-nota">{t.subP}</p>
      <form class="sub-form" id="sub-form" data-lang={lang}>
        <input type="email" id="sub-email" required autocomplete="email"
               placeholder={t.subPlaceholder} aria-label={t.subT} />
        <button type="submit" id="sub-btn">{t.subBoton}</button>
      </form>
      <p class="sub-msg" id="sub-msg" hidden></p>
    </div>
  </div>
</section>

<section class="contents">
  {/* Los filtros, en el raíl de la retícula y en UNA línea que se desliza.
      Ocupaban tres renglones a ancho completo —más alto que el bloque del
      semanal— para una utilidad que casi nunca se toca. Ahora el recuento va a
      la izquierda, donde van los datos en toda la página, y los temas corren a
      su derecha; lo que no cabe se alcanza deslizando, sin empujar la portada
      hacia abajo. */}
  <div class="cover-filter">
    <span class="cover-count">{articles.length} {articles.length === 1 ? t.piece : t.pieces} · 2026</span>
    <div class="filter-topics" id="filter">
      <button class="f on" data-t="all">{t.all}</button>
      {topics.map(x => <button class="f" data-t={x}>{x}</button>)}
    </div>
  </div>

  {/* El semanal es una CABECERA, no una pieza más: por eso ocupa el ancho
      entero en dos columnas —el rótulo a la izquierda, el número a la derecha—
      con reglas gruesas arriba y abajo. Antes se presentaba con la misma forma
      que un artículo y por eso se leía como uno más. */}
  {/* El semanal: enlaza el TÍTULO DEL NÚMERO, que es lo que se va a leer.
      Antes el enlace envolvía el bloque entero —rótulo, fecha, temas—, así que
      no había nada que señalara qué se abría al pulsar; y la fecha vivía en la
      columna del rótulo, lejos del titular al que pertenece. Ahora fecha,
      titular y temas van juntos: son el número. */}
  <div class="cover-weekly-wrap">
    <div class="cover-weekly">
      <div class="cover-weekly-flag">
        <span class="cover-weekly-title">{t.weekly.title}</span>
        <span class="cover-weekly-cadencia">{t.weekly.tag}</span>
        <a class="cover-weekly-archivo" href={hrefArchivo}>{t.weekly.archivo}</a>
      </div>
      <div class="cover-weekly-cuerpo">
        <span class="cover-weekly-tag">
          {esDeEstaSemana ? t.weekly.thisWeek : t.weekly.latest}
          {fechaNumero && <span class="cover-weekly-fecha">{fechaNumero}</span>}
        </span>
        {tituloNumero && (
          <a class="cover-weekly-numero" href={lang === "es" ? "/es/weekly/" : "/weekly/"}>
            {tituloNumero}
          </a>
        )}
        {temas.length > 0 && (
          <ul class="cover-weekly-temas">
            {temas.map(x => <li>{x}</li>)}
          </ul>
        )}
      </div>
    </div>
  </div>

  {featured && (
    <a class="article-card featured" href={href(featured)} data-topics={keyOf(featured)}>
      {/* La misma retícula del semanal: los datos en el raíl izquierdo y el
          texto en la columna ancha. Antes cada tarjeta apilaba todo a la
          izquierda y dejaba media página en blanco. */}
      <div class="article-card-rail">
        <span class="featured-tag">{t.featured}</span>
        <span class="article-card-number">{featured.data.issue}</span>
        <span class="article-card-date">{featured.data.date}</span>
        {featured.data.track && featured.data.track !== 'general' && <span class="article-card-track">{featured.data.track}</span>}
      </div>
      <div class="article-card-cuerpo">
        <h2 class="article-card-title" set:html={featured.data.titleHTML} />
        <p class="article-card-dek" set:html={featured.data.coverDek} />
        <ul class="article-card-topics">
          {featured.data.topics.map(x => <li>{x}</li>)}
        </ul>
      </div>
    </a>
  )}

  <div id="list">
    {rest.map((a) => (
      <a class="article-card" href={href(a)} data-topics={keyOf(a)}>
        <div class="article-card-rail">
          <span class="article-card-number">{a.data.issue}</span>
          <span class="article-card-date">{a.data.date}</span>
          {a.data.track && a.data.track !== 'general' && <span class="article-card-track">{a.data.track}</span>}
        </div>
        <div class="article-card-cuerpo">
          <h2 class="article-card-title" set:html={a.data.titleHTML} />
          <p class="article-card-dek" set:html={a.data.coverDek} />
          <ul class="article-card-topics">
            {a.data.topics.map(x => <li>{x}</li>)}
          </ul>
        </div>
      </a>
    ))}
  </div>

  <p class="cover-empty" hidden>{t.empty}</p>

</section>

<script is:inline define:vars={{ endpoint: (import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL || '') + '/functions/v1/glossa-boletin' }}>
  (function () {
    var f = document.getElementById('sub-form');
    if (!f) return;
    var msg = document.getElementById('sub-msg');
    var btn = document.getElementById('sub-btn');
    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      var email = document.getElementById('sub-email').value.trim();
      if (!email) return;
      btn.disabled = true;
      try {
        var r = await fetch(endpoint, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, lang: f.dataset.lang, intent: 'acceso' }),
        });
        var d = await r.json();
        msg.textContent = d.error || d.mensaje;
        msg.hidden = false;
        // El formulario se retira al acertar: dejarlo invita a mandarlo otra
        // vez y a recibir dos correos de confirmación.
        if (!d.error) f.hidden = true;
      } catch (err) {
        msg.textContent = 'Could not reach the server. Try again in a minute.';
        msg.hidden = false;
      }
      btn.disabled = false;
    });
  })();
</script>

<footer class="footer">
  <span>{t.footer}</span>
  <span class="footer-links">
    <a href={t.other.href}>{t.other.label}</a>
  </span>
</footer>

<script is:inline>
  (function () {
    var btns = document.querySelectorAll('.cover-filter .f');
    var cards = document.querySelectorAll('.article-card[data-topics]');
    var empty = document.querySelector('.cover-empty');
    btns.forEach(function (b) {
      b.addEventListener('click', function () {
        var t = b.dataset.t;
        btns.forEach(function (x) { x.classList.toggle('on', x === b); });
        var shown = 0;
        cards.forEach(function (c) {
          var has = t === 'all' || ('|' + c.dataset.topics + '|').indexOf('|' + t + '|') > -1;
          if (has) { c.removeAttribute('hidden'); shown++; } else { c.setAttribute('hidden', ''); }
        });
        // Antes, un filtro sin resultados dejaba la lista en blanco sin explicar por qué.
        if (empty) { if (shown === 0) empty.removeAttribute('hidden'); else empty.setAttribute('hidden', ''); }
      });
    });
  })();
</script>
