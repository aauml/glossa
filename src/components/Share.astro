---
/**
 * Copiar el enlace de ESTA página. Un icono, del tamaño y el color de los otros
 * mandos, dentro de la pieza y no en la cabecera.
 *
 * Copia la página en la que estás: si lees en inglés, el enlace inglés; si lees
 * en español, el español. Nada que elegir — la elección ya la hiciste al abrir
 * la página que estás leyendo, y un menú para repetirla es una decisión de más.
 *
 * La primera versión era un botón de texto con dos opciones en la cabecera.
 * Eran tres cosas mal: texto donde el resto son iconos, un menú donde bastaba
 * un clic, y en la cabecera, que es del sitio y no de lo que se lee.
 */
const { lang = 'en' } = Astro.props;
const T = lang === 'es'
  ? { titulo: 'Copiar el enlace', ok: 'enlace copiado' }
  : { titulo: 'Copy link',        ok: 'link copied' };
---
<span class="copiar" data-copiar>
  <button type="button" aria-label={T.titulo} title={T.titulo}>
    <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
      <path d="M6.6 9.4a2.6 2.6 0 0 0 3.7 0l2.3-2.3a2.6 2.6 0 0 0-3.7-3.7l-1 1"
            fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M9.4 6.6a2.6 2.6 0 0 0-3.7 0L3.4 8.9a2.6 2.6 0 0 0 3.7 3.7l1-1"
            fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    </svg>
  </button>
  <span class="copiar-ok" data-ok hidden>{T.ok}</span>
</span>

<script>
  for (const caja of document.querySelectorAll('[data-copiar]')) {
    const btn = caja.querySelector('button');
    const ok = caja.querySelector('[data-ok]');
    let reloj = null;
    btn.addEventListener('click', async () => {
      // La URL limpia: sin el #ancla al que hayas saltado leyendo, que mandaría
      // a quien lo abra a la mitad de una sección en vez de al principio.
      const url = location.origin + location.pathname;
      try { await navigator.clipboard.writeText(url); }
      catch {
        // Sin permiso de portapapeles, la vía de siempre: seleccionarlo y
        // copiarlo. Falla en silencio antes que mentir con «copiado».
        const t = document.createElement('textarea');
        t.value = url; t.style.position = 'fixed'; t.style.opacity = '0';
        document.body.appendChild(t); t.select();
        try { document.execCommand('copy'); } catch { document.body.removeChild(t); return; }
        document.body.removeChild(t);
      }
      ok.hidden = false;
      clearTimeout(reloj);
      reloj = setTimeout(() => { ok.hidden = true; }, 1600);
    });
  }
</script>
