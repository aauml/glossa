---
import SizeSwitch from './SizeSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import PanelLink from './PanelLink.astro';
// La portada no tenía conmutador de idioma porque solo existía en inglés.
const { lang = 'en' } = Astro.props;
const LANGS = [{ code: 'en', label: 'EN', href: '/' }, { code: 'es', label: 'ES', href: '/es/' }];
---
<header class="masthead">
  <div class="masthead-inner">
    <span class="masthead-brand">Glossa<span class="wm-dot">.</span></span>
    <span class="masthead-meta">
      {/* UN control de idioma, no dos: se ofrece la lengua a la que se puede
          ir. Enseñar la actual marcada y la otra enlazada gastaba dos objetos
          de la barra para decir algo que un solo enlace ya dice. */}
      {LANGS.filter(l => l.code !== lang).map(l => (
        <a href={l.href} class="lang-link" hreflang={l.code}
           title={l.code === 'es' ? 'Leer en español' : 'Read in English'}>{l.label}</a>
      ))}
      <SizeSwitch separator />
      <ThemeSwitch separator />
      <PanelLink separator />
    </span>
  </div>
</header>
